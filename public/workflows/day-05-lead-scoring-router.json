    {
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const b = item.json.body || item.json;\n  let score = 0;\n  const budget = Number(b.budget) || 0;\n  if (budget >= 50000) score += 40; else if (budget >= 15000) score += 25; else score += 5;\n  if (b.urgency === 'this week') score += 30; else if (b.urgency === 'this month') score += 15;\n  if (b.source === 'referral') score += 20; else if (b.source === 'website') score += 10;\n  if (b.company) score += 10;\n  return { json: { ...b, score: Math.min(score, 100) } };\n});"
      },
