      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        160,
        520
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tum ek helpful sales assistant ho jo ek Indian automation agency ke liye kaam karta hai.\nNeeche diye email ko padho aur:\n1. sentiment batao (positive / neutral / negative)\n2. 3 line ka polite reply draft karo — simple English, koi fake promise nahi, end mein 15-min call ka offer.\n\nFrom: {{ $('New Email').item.json.From }}\nSubject: {{ $('New Email').item.json.Subject }}\nEmail: {{ $('New Email').item.json.snippet }}",
        "hasOutputParser": true
      },
      "id": "aa9ce39b-27db-4975-a559-c09c92dc099d",
      "name": "Draft Sales Reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "options": {}
      },
      "id": "ac569d48-6f76-4db6-a675-65ffdad2d694",
      "name": "Reply Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        420,
        320
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"sentiment\": \"positive\", \"reply\": \"Hi ...\" }"
      },
      "id": "d802d651-5f99-4428-a4a2-9a926b88f46a",
      "name": "Reply JSON",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
