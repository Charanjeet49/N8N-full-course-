            },
            {
              "category": "support",
              "description": "Existing customer ki problem, bug, refund, order issue"
            },
            {
              "category": "spam",
              "description": "Promotions, newsletters, cold SEO offers, irrelevant"
            }
          ]
        },
        "options": {}
