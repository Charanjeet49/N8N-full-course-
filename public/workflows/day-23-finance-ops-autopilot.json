    {
      "parameters": {
        "jsCode": "// Ledger columns: date, type (income/expense), category, amount\nconst m = new Date(); m.setMonth(m.getMonth() - 1);\nconst key = m.toISOString().slice(0, 7);\nconst rows = $input.all().map((i) => i.json).filter((r) => String(r.date).startsWith(key));\nconst sum = (t) => rows.filter((r) => r.type === t).reduce((a, r) => a + Number(r.amount || 0), 0);\nconst income = sum('income'), expense = sum('expense');\nconst cats = {};\nrows.filter((r) => r.type === 'expense').forEach((r) => { cats[r.category] = (cats[r.category] || 0) + Number(r.amount || 0); });\nconst top = Object.entries(cats).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([c, v]) => '<li>' + c + ': ₹' + v.toLocaleString('en-IN') + '</li>').join('');\nreturn [{ json: { month: key, html: '<h2>P&L — ' + key + '</h2><p>Income: ₹' + income.toLocaleString('en-IN') + '<br>Expense: ₹' + expense.toLocaleString('en-IN') + '<br><b>Profit: ₹' + (income - expense).toLocaleString('en-IN') + '</b></p><h4>Top expenses</h4><ul>' + top + '</ul>' } }];"
      },
      "id": "5b2b5da1-a341-4eda-a89a-16bdfeaa2af3",
