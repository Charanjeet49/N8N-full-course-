        260,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0e19fad6-2fc0-4e2c-aec9-218b748ee770",
              "name": "payment_id",
              "value": "={{ $json.body.payload.payment.entity.id }}",
              "type": "string"
            },
            {
              "id": "147ffcb8-4d35-4e33-ac60-7101e73525b4",
              "name": "email",
              "value": "={{ $json.body.payload.payment.entity.email }}",
              "type": "string"
            },
            {
              "id": "143cebeb-343f-4446-a635-4a0e6ed55c60",
              "name": "phone",
              "value": "={{ $json.body.payload.payment.entity.contact }}",
              "type": "string"
            },
            {
              "id": "d6f911ab-923d-4fe9-aedb-197af3100d69",
              "name": "total",
              "value": "={{ $json.body.payload.payment.entity.amount / 100 }}",
              "type": "number"
            },
            {
              "id": "d70918cc-5a05-4758-a36c-e1e5ee1deddc",
              "name": "taxable",
              "value": "={{ Math.round(($json.body.payload.payment.entity.amount / 100) / 1.18 * 100) / 100 }}",
              "type": "number"
            },
            {
              "id": "fb36db12-f0c6-4b05-a9af-390b09724d84",
              "name": "invoice_no",
              "value": "={{ 'INV-' + $now.toFormat('yyyyMMdd-HHmmss') }}",
              "type": "string"
            },
            {
              "id": "022c8c57-7629-4674-af44-7cd783f5117b",
              "name": "date",
              "value": "={{ $now.toFormat('dd LLL yyyy') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6e941b67-922a-4ecc-a90d-69b689a00549",
      "name": "Invoice Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: j }) => {\n  const gst = Math.round((j.total - j.taxable) * 100) / 100;\n  const html = '<div style=\"font-family:Arial;max-width:560px\"><h2>Tax Invoice ' + j.invoice_no + '</h2><p>Date: ' + j.date + '<br>Payment: ' + j.payment_id + '</p>' +\n    '<table width=\"100%\" cellpadding=\"8\" style=\"border-collapse:collapse\" border=\"1\">' +\n    '<tr><td>Taxable value</td><td align=\"right\">₹' + j.taxable + '</td></tr>' +\n    '<tr><td>CGST 9%</td><td align=\"right\">₹' + (gst / 2).toFixed(2) + '</td></tr>' +\n    '<tr><td>SGST 9%</td><td align=\"right\">₹' + (gst / 2).toFixed(2) + '</td></tr>' +\n    '<tr><td><b>Total</b></td><td align=\"right\"><b>₹' + j.total + '</b></td></tr></table><p>Thank you for your purchase!</p></div>';\n  return { json: { ...j, gst, html } };\n});"
      },
      "id": "160d0e44-213c-4acc-a16a-368b9a71d2ff",
      "name": "HTML Invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
