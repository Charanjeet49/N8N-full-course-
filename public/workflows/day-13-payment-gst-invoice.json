      "name": "Razorpay Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "a29383df-d436-41e0-a4a7-11b2000ed7ec"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "80cd14bb-7c69-4d44-a5f5-264217699609",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "payment.captured",
              "operator": {
