  "nodes": [
    {
      "parameters": {
        "content": "## Day 9: Telegram Appointment Booking Bot\n\n\n**Setup:**\n- Connect: Telegram bot token (BotFather se)\n- Connect: Google Calendar (Google OAuth)\n- @BotFather se naya bot banao aur token Telegram credential mein daalo\n- Workflow Active karo (Telegram trigger ko public URL chahiye)\n\nCourse: Day 9 lesson page",
        "height": 300,
        "width": 420,
        "color": 5
      },
      "id": "99167ea0-21a5-42d0-a46f-91961a5035d5",
      "name": "Setup Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -160
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
