      "name": "Telegram Message",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "webhookId": "cc16cc81-7cad-47aa-acff-c2349921f044"
    },
    {
      "parameters": {
        "jsCode": "// Format: book YYYY-MM-DD HH:MM\nconst msg = $json.message;\nconst m = (msg.text || '').match(/book\\s+(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{1,2}:\\d{2})/i);\nif (!m) return [{ json: { valid: false, chat_id: msg.chat.id } }];\nconst start = new Date(m[1] + 'T' + m[2].padStart(5, '0') + ':00+05:30');\nconst end = new Date(start.getTime() + 30 * 60000);\nreturn [{ json: { valid: true, chat_id: msg.chat.id, name: msg.from.first_name, start: start.toISOString(), end: end.toISOString(), label: m[1] + ' ' + m[2] } }];"
      },
      "id": "4a1cd733-8e90-4da8-a243-3aaa045190cf",
      "name": "Parse Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0b457ed6-b67e-4744-a3bf-6178d0ab3aec",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cbd38867-b66c-4ef0-aecf-5e4a02fd72ec",
      "name": "Format OK?",
