            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "55e231bf-6177-4fc4-a838-6dce5c48a629",
              "leftValue": "={{ $('Normalize Email').isExecuted }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a8e987b0-64c6-4945-a65d-c1cbde5d73de",
      "name": "Email or Chat?",
